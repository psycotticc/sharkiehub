local mouseConn = nil
local deleteClickConn = nil
local deletePreviewBox = nil

local function toggleDeleteWalls(enable)
	toggles.DeleteWalls = enable
	if enable then
		mouseConn = RunService.RenderStepped:Connect(function()
			if deletePreviewBox then deletePreviewBox:Destroy() deletePreviewBox = nil end
			local target = mouse.Target
			if target and target:IsA("BasePart") and not target:IsDescendantOf(player.Character) and not target.Locked then
				-- No borrar personajes
				local isCharacterPart = false
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Character and target:IsDescendantOf(p.Character) then
						isCharacterPart = true
						break
					end
				end
				if isCharacterPart then return end

				deletePreviewBox = Instance.new("Highlight")
				deletePreviewBox.Adornee = target
				deletePreviewBox.FillTransparency = 1
				deletePreviewBox.OutlineColor = Color3.fromRGB(255, 0, 100)
				deletePreviewBox.OutlineTransparency = 0
				deletePreviewBox.Parent = target
			end
		end)
		deleteClickConn = UserInputService.InputBegan:Connect(function(input, gp)
			if gp then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1 and (UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)) and toggles.DeleteWalls then
				local target = mouse.Target
				if target and target:IsA("BasePart") and not target:IsDescendantOf(player.Character) and not target.Locked then
					local isCharacterPart = false
					for _, p in ipairs(Players:GetPlayers()) do
						if p.Character and target:IsDescendantOf(p.Character) then
							isCharacterPart = true
							break
						end
					end
					if isCharacterPart then return end

					local nameLower = target.Name:lower()
					if nameLower:find("floor") or nameLower:find("baseplate") or nameLower:find("suelo") or nameLower:find("ground") then return end
					table.insert(deletedParts, {obj = target, parent = target.Parent})
					target.Parent = nil
				end
			end
		end)
	else
		if mouseConn then mouseConn:Disconnect() mouseConn = nil end
		if deleteClickConn then deleteClickConn:Disconnect() deleteClickConn = nil end
		if deletePreviewBox then deletePreviewBox:Destroy() deletePreviewBox = nil end
	end
end


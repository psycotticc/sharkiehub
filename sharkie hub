			sellMarshBtn.BackgroundColor3 = Color3.fromRGB(50,50,80)
			if sellGui then sellGui.Enabled = false end
		end
	end)
	yPos = yPos + 80

	-- CONFIGURACIONES
	local configTitle = Instance.new("TextLabel")
	configTitle.Size = UDim2.new(0.9,0,0,40)
	configTitle.Position = UDim2.new(0.05,0,0,yPos)
	configTitle.BackgroundTransparency = 1
	configTitle.Text = "Configuraciones"
	configTitle.TextColor3 = Color3.fromRGB(200, 200, 255)
	configTitle.Font = Enum.Font.GothamBold
	configTitle.TextSize = 22
	configTitle.TextXAlignment = Enum.TextXAlignment.Left
	configTitle.Parent = contentFrame
	yPos = yPos + 50

	local configNameBox = Instance.new("TextBox")
	configNameBox.Size = UDim2.new(0.65,0,0,40)
	configNameBox.Position = UDim2.new(0.05,0,0,yPos)
	configNameBox.BackgroundColor3 = Color3.fromRGB(40,40,70)
	configNameBox.Text = ""
	configNameBox.TextColor3 = Color3.new(1,1,1)
	configNameBox.Font = Enum.Font.Gotham
	configNameBox.TextSize = 18
	configNameBox.PlaceholderText = "Nombre de la config"
	Instance.new("UICorner", configNameBox).CornerRadius = UDim.new(0,10)
	configNameBox.Parent = contentFrame

	local saveBtn = Instance.new("TextButton")
	saveBtn.Size = UDim2.new(0.25,0,0,40)
	saveBtn.Position = UDim2.new(0.72,0,0,yPos)
	saveBtn.BackgroundColor3 = Color3.fromRGB(60,180,100)
	saveBtn.Text = "Guardar"
	saveBtn.TextColor3 = Color3.new(1,1,1)
	saveBtn.Font = Enum.Font.GothamBold
	saveBtn.TextSize = 18
	Instance.new("UICorner", saveBtn).CornerRadius = UDim.new(0,10)
	saveBtn.Parent = contentFrame
	saveBtn.MouseButton1Click:Connect(function()
		saveCurrentConfig(configNameBox.Text)
		updateConfigList()
		configNameBox.Text = ""
	end)
	yPos = yPos + 60

	local configScrolling = Instance.new("ScrollingFrame")
	configScrolling.Size = UDim2.new(0.9,0,0,300)
	configScrolling.Position = UDim2.new(0.05,0,0,yPos)
	configScrolling.BackgroundTransparency = 1
	configScrolling.ScrollBarThickness = 6
	configScrolling.CanvasSize = UDim2.new(0,0,0,0)
	configScrolling.Parent = contentFrame

	local configLayout = Instance.new("UIListLayout")
	configLayout.SortOrder = Enum.SortOrder.LayoutOrder
	configLayout.Padding = UDim.new(0,8)
	configLayout.Parent = configScrolling

	local function updateConfigList()
		for _, child in ipairs(configScrolling:GetChildren()) do
			if child:IsA("Frame") then child:Destroy() end
		end
		local count = 0
		getgenv().SharkieHubConfigs = getgenv().SharkieHubConfigs or {}
		for name, _ in pairs(getgenv().SharkieHubConfigs) do
			count = count + 1
			local entry = Instance.new("Frame")
			entry.Size = UDim2.new(1,0,0,50)
			entry.BackgroundColor3 = Color3.fromRGB(40,40,70)
			entry.Parent = configScrolling
			Instance.new("UICorner", entry).CornerRadius = UDim.new(0,10)
			local nameLabel = Instance.new("TextLabel")
			nameLabel.Size = UDim2.new(0.5,0,1,0)
			nameLabel.Position = UDim2.new(0,10,0,0)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Text = name
			nameLabel.TextColor3 = Color3.new(1,1,1)
			nameLabel.Font = Enum.Font.GothamSemibold
			nameLabel.TextSize = 18
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.Parent = entry
			local loadB = Instance.new("TextButton")
			loadB.Size = UDim2.new(0.22,0,0.8,0)
			loadB.Position = UDim2.new(0.52,0,0.1,0)
			loadB.BackgroundColor3 = Color3.fromRGB(60,180,100)
			loadB.Text = "Cargar"
			loadB.TextColor3 = Color3.new(1,1,1)
			loadB.Font = Enum.Font.GothamBold
			loadB.TextSize = 16
			loadB.Parent = entry
			Instance.new("UICorner", loadB).CornerRadius = UDim.new(0,8)
			loadB.MouseButton1Click:Connect(function() loadConfig(name) end)
			local delB = Instance.new("TextButton")
			delB.Size = UDim2.new(0.22,0,0.8,0)
			delB.Position = UDim2.new(0.76,0,0.1,0)
			delB.BackgroundColor3 = Color3.fromRGB(220,50,50)
			delB.Text = "Borrar"
			delB.TextColor3 = Color3.new(1,1,1)
			delB.Font = Enum.Font.GothamBold
			delB.TextSize = 16
			delB.Parent = entry
			Instance.new("UICorner", delB).CornerRadius = UDim.new(0,8)
			delB.MouseButton1Click:Connect(function() deleteConfig(name) updateConfigList() end)
		end
		configScrolling.CanvasSize = UDim2.new(0,0,0,count * 68)
	end
	updateConfigList()
	yPos = yPos + 320
	contentFrame.CanvasSize = UDim2.new(0,0,0,yPos + 100)

	-- Auto-restore
	if getgenv().SharkieHubConfig then
		for k, v in pairs(getgenv().SharkieHubConfig) do
			if toggles[k] ~= nil then
				toggles[k] = v
				if toggleButtons[k] then
					local b = toggleButtons[k]
					b.Text = k .. (k == "Aimbot" and " (T)" or k == "Aimbot FOV" and "" or k == "Hitbox Pecho" and " (L)" or k == "DELETE WALLS" and "" or "") .. " [" .. (v and "ON" or "OFF") .. "]"
					b.BackgroundColor3 = v and Color3.fromRGB(60,180,100) or Color3.fromRGB(50,50,80)
				end
				if k == "Aimbot" then toggleAimbot(v) end
				if k == "AimbotFOV" then toggleAimbotFOV(v) end
				if k == "HitboxPecho" then toggleHitboxPecho(v) end
				if k == "DeleteWalls" then toggleDeleteWalls(v) end
				if k == "Chams" then toggleChams(v) end
				if k == "Esqueleto" then toggleEsqueleto(v) end
				if k == "Nombres" then toggleNombres(v) end
				if k == "InstantInteract" then toggleInstantInteract(v) end
				if k == "InfinityZoom" then toggleInfinityZoom(v) end
				if k == "Fly" then toggleFly(v) end
				if k == "Tracers" then toggleTracers(v) end
				if k == "Noclip" then toggleNoclip(v) end
				if k == "JawaHub" then toggleJawaHub(v) end
				if k == "ESP" then toggleESP(v) end
			end
		end
		print("[AUTO-SAVE] Configuración anterior restaurada")
	end
	updateConfigList()
end


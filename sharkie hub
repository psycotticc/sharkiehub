local function updateEsqueleto()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local char = p.Character
			if not skeletonDrawings[p] then skeletonDrawings[p] = {} end
			for _, pair in ipairs(skeletonConnections) do
				local part1 = char:FindFirstChild(pair[1])
				local part2 = char:FindFirstChild(pair[2])
				if part1 and part2 then
					local key = pair[1] .. "_" .. pair[2]
					if not skeletonDrawings[p][key] then
						local line = Drawing.new("Line")
						line.Color = skeletonColor
						line.Thickness = 2
						line.Transparency = 1
						skeletonDrawings[p][key] = line
					end
					local pos1, on1 = camera:WorldToViewportPoint(part1.Position)
					local pos2, on2 = camera:WorldToViewportPoint(part2.Position)
					if on1 and on2 then
						skeletonDrawings[p][key].From = Vector2.new(pos1.X, pos1.Y)
						skeletonDrawings[p][key].To = Vector2.new(pos2.X, pos2.Y)
						skeletonDrawings[p][key].Visible = toggles.Esqueleto
						skeletonDrawings[p][key].Color = skeletonColor
					else
						skeletonDrawings[p][key].Visible = false
					end
				end
			end
		end
	end
end


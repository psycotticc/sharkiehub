-- ====================== HITBOX PECHO [L] ======================
local hitboxConnections = {}
local originalSizes = {}

local function toggleHitboxPecho(enable)
	toggles.HitboxPecho = enable
	if enable then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and not whitelist[p.UserId] then
				local char = p.Character
				if char then
					local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso")
					if torso and not originalSizes[p] then
						originalSizes[p] = torso.Size
					end
				end
			end
		end

		local hitboxConn = RunService.RenderStepped:Connect(function()
			if not toggles.HitboxPecho then return end
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player and not whitelist[p.UserId] and p.Character then
					local hum = p.Character:FindFirstChild("Humanoid")
					if hum and hum.Health > 0 then
						local torso = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("LowerTorso")
						if torso then
							torso.Size = Vector3.new(4.5, 4.5, 4.5) -- más pequeño
							torso.Transparency = 0.4 -- más visible
							torso.Color = Color3.fromRGB(255, 100, 100)
							torso.CanCollide = false
							torso.CanTouch = true
						end
					end
				end
			end
		end)
		table.insert(hitboxConnections, hitboxConn)

		local addedConn = Players.PlayerAdded:Connect(function(p)
			if p ~= player and not whitelist[p.UserId] then
				p.CharacterAdded:Connect(function(char)
					task.wait(1.2)
					if toggles.HitboxPecho then
						local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso")
						if torso and not originalSizes[p] then originalSizes[p] = torso.Size end
					end
				end)
			end
		end)
		table.insert(hitboxConnections, addedConn)

	else
		for _, conn in ipairs(hitboxConnections) do conn:Disconnect() end
		hitboxConnections = {}
		for p, origSize in pairs(originalSizes) do
			local char = p.Character
			if char then
				local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso")
				if torso then
					torso.Size = origSize
					torso.Transparency = 0
					torso.Color = Color3.fromRGB(163, 162, 165)
					torso.CanCollide = true
					torso.CanTouch = true
				end
			end
		end
		originalSizes = {}
	end

	if toggleButtons["Hitbox Pecho"] then
		local b = toggleButtons["Hitbox Pecho"]
		b.Text = "Hitbox Pecho (L) [" .. (enable and "ON" or "OFF") .. "]"
		b.BackgroundColor3 = enable and Color3.fromRGB(60,180,100) or Color3.fromRGB(50,50,80)
	end
end

-- ====================== FOV + SILENT AIM MUY AGRESIVO ======================
local function createFovCircle()
	if fovCircle then fovCircle:Remove() end
	fovCircle = Drawing.new("Circle")
	fovCircle.Thickness = 2
	fovCircle.NumSides = 64
	fovCircle.Radius = fovRadius
	fovCircle.Color = fovColor
	fovCircle.Transparency = 0.7
	fovCircle.Filled = false
	fovCircle.Visible = false
end

local function isInFOV(targetPos)
	if not fovEnabled or not fovCircle then return false end
	local screenPos, onScreen = camera:WorldToViewportPoint(targetPos)
	if not onScreen then return false end
	local mousePos = Vector2.new(mouse.X, mouse.Y + 58)
	return (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude <= fovRadius
end

local function getClosestTargetInFOV()
	local closest = nil
	local minDist = math.huge
	local myPos = player.Character and player.Character.PrimaryPart and player.Character.PrimaryPart.Position
	if not myPos then return nil end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("Head") and p.Character.Humanoid.Health > 0 and not aimbotExceptions[p.UserId] then
			local headPos = p.Character.Head.Position
			if isInFOV(headPos) then
				local dist = (myPos - headPos).Magnitude
				if dist < minDist then
					minDist = dist
					closest = p
				end
			end
		end
	end
	return closest
end

local function updateFovCircle()
	if not fovCircle then createFovCircle() end
	fovCircle.Position = Vector2.new(mouse.X, mouse.Y + 58)
	fovCircle.Radius = fovRadius
	fovCircle.Color = fovColor
	fovCircle.Visible = fovEnabled

	local target = getClosestTargetInFOV()
	if target and target.Character and target.Character:FindFirstChild("Head") then
		if not silentAimLine then
			silentAimLine = Drawing.new("Line")
			silentAimLine.Color = Color3.fromRGB(255, 0, 255)
			silentAimLine.Thickness = 2.5
			silentAimLine.Transparency = 0.6
		end
		local head = target.Character.Head
		local headScreen = camera:WorldToViewportPoint(head.Position)
		silentAimLine.From = Vector2.new(mouse.X, mouse.Y + 58)
		silentAimLine.To = Vector2.new(headScreen.X, headScreen.Y)
		silentAimLine.Visible = true

		mouse.Target = head
		mouse.Hit = CFrame.new(head.Position + head.Velocity * 0.22)
	else
		if silentAimLine then silentAimLine.Visible = false end
	end
end

local function toggleFov(enable)
	fovEnabled = enable
	if enable then
		createFovCircle()
		if not fovConnection then
			fovConnection = RunService.RenderStepped:Connect(updateFovCircle)
		end
	else
		if fovCircle then fovCircle.Visible = false end
		if fovConnection then fovConnection:Disconnect() fovConnection = nil end
		if silentAimLine then silentAimLine:Remove() silentAimLine = nil end
	end
	if toggleButtons["FOV"] then
		local b = toggleButtons["FOV"]
		b.Text = "FOV [" .. (enable and "ON" or "OFF") .. "]"
		b.BackgroundColor3 = enable and Color3.fromRGB(60,180,100) or Color3.fromRGB(50,50,80)
	end
end


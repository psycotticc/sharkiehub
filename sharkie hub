-- ====================== ESP ======================
local espDrawings = {}
local espConnection = nil

local function cleanupESP(p)
	if espDrawings[p] then
		if espDrawings[p].Box then espDrawings[p].Box:Remove() end
		if espDrawings[p].HealthBar then espDrawings[p].HealthBar:Remove() end
		if espDrawings[p].Inventory then espDrawings[p].Inventory:Remove() end
		espDrawings[p] = nil
	end
end

local function updateESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
			local char = p.Character
			local hum = char.Humanoid
			local hrp = char.HumanoidRootPart

			if not espDrawings[p] then
				espDrawings[p] = {}
				local box = Drawing.new("Square")
				box.Visible = false
				box.Color = Color3.fromRGB(255, 255, 255)
				box.Thickness = 1
				box.Filled = false
				espDrawings[p].Box = box

				local healthBar = Drawing.new("Line")
				healthBar.Visible = false
				healthBar.Thickness = 3
				espDrawings[p].HealthBar = healthBar

				local invText = Drawing.new("Text")
				invText.Visible = false
				invText.Color = Color3.new(1, 1, 1)
				invText.Size = 13
				invText.Center = true
				invText.Outline = true
				espDrawings[p].Inventory = invText
			end

			local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
			if onScreen then
				local top = camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
				local bottom = camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, -3.5, 0))
				local boxHeight = math.abs(top.Y - bottom.Y)
				local boxWidth = boxHeight * 0.55

				local boxX = pos.X - (boxWidth / 2)
				local boxY = pos.Y - (boxHeight / 2)

				espDrawings[p].Box.Size = Vector2.new(boxWidth, boxHeight)
				espDrawings[p].Box.Position = Vector2.new(boxX, boxY)
				espDrawings[p].Box.Visible = toggles.ESP

				local healthBarX = boxX - 8
				espDrawings[p].HealthBar.From = Vector2.new(healthBarX, boxY + boxHeight)
				espDrawings[p].HealthBar.To = Vector2.new(healthBarX, boxY + boxHeight - (boxHeight * (hum.Health / hum.MaxHealth)))
				espDrawings[p].HealthBar.Color = Color3.fromHSV(hum.Health/hum.MaxHealth * 0.3, 1, 1)
				espDrawings[p].HealthBar.Visible = toggles.ESP

				local items = {}
				local toolInHand = char:FindFirstChildOfClass("Tool")
				if toolInHand then table.insert(items, "[" .. toolInHand.Name .. "]") end
				for _, item in pairs(p.Backpack:GetChildren()) do
					if item:IsA("Tool") then table.insert(items, item.Name) end
				end
				espDrawings[p].Inventory.Text = table.concat(items, "\n")
				espDrawings[p].Inventory.Position = Vector2.new(pos.X, boxY + boxHeight + 8)
				espDrawings[p].Inventory.Visible = toggles.ESP
			else
				espDrawings[p].Box.Visible = false
				espDrawings[p].HealthBar.Visible = false
				espDrawings[p].Inventory.Visible = false
